# The port the proxy listens on (127.0.0.1 only).
PROXY_PORT=3086
# How long one answer may take (the web app is slow on a busy account).
GEMINI_TIMEOUT=450
# How long the first request to a fresh account may take (it fetches the model list).
GEMINI_INIT_TIMEOUT=120
# The model used when the caller does not name one.
GEMINI_DEFAULT_MODEL=gemini-4-hydrogen
# Where the accounts live. Written by the login tool, read by the proxy.
ACCOUNTS_FILE=/etc/gemini-proxy/accounts.json
# Key for the admin routes (/admin/accounts). Without it those routes do not exist.
PROXY_ADMIN_KEY=
# How many accounts one request may try before it gives up.
POOL_MAX_RETRIES=3
# How often the accounts file is re-read (the browser session owner refreshes the cookies).
ACCOUNTS_RELOAD_S=60
# SOCKS5/HTTP proxy for google.com, when the server needs one.
GEMINI_PROXY=
